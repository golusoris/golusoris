# Audit clones — temporary, only used during the initial cross-repo audit.
_audit/

# Build artifacts
bin/
coverage*.out
dist/
*.exe
*.dll
*.so
*.dylib
coverage.out
coverage.html
*.test
*.prof

# Editor / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Env / secrets
.env
.env.*
!.env.example
*.pem
*.key
# NOTE: do not ignore /secrets/ — it is the framework's secrets/ Go package.
# Actual secret files are covered by the .env / *.pem / *.key rules above.

# Tooling caches
.golangci-lint-cache/
.mockery-cache/
tmp/
.tmp/

# Claude Code runtime state (personal, machine-local).
# Team-shared config lives in .claude/settings.json + .claude/hooks/.
.claude/settings.local.json
.claude/scheduled_tasks.lock

# built MCP binary
/golusoris-mcp

# praetor governance runtime state (ephemeral worktrees, receipts)
.standards/
.golusoris/worktrees/

# Compiled deploy binaries are build outputs, never checked in (OSSF Scorecard BinaryArtifacts).
/deploy/pulumi/pulumi
/deploy/multiregion/multiregion

# Claude Code worktrees (personal, machine-local; never checked in).
/.claude/worktrees/

# Node tooling, when present (e.g. docs tooling, editor extensions).
node_modules/

# .workingdir/ is private, git-ignored session state (PLAN.md, STATE.md,
# decisions log, scratch files) per praetor HISS-17 — never staged, including
# with force. Publish reviewed, sanitized documentation under docs/ instead.
# The nested rule covers per-package copies (e.g. deploy/pulumi/.workingdir/).
# Keep /.workingdir/ as the final line: praetor's adopt recognises this exact
# trailing rule and will not re-append it on a future non-force adopt.
.workingdir/
/.workingdir/
