# Golden output and test vectors are compared byte for byte on every OS.
core/clikit/testdata/golden/** text eol=lf
junit/testdata/** text eol=lf
core/codec/jcs/testdata/cyberphone/** -text
.config/hiss/testdata/README.md text eol=lf
media/audio/testdata/** -text
testutil/fixture/testdata/** text eol=lf
# Client caps count characters; a CRLF checkout must not push AGENTS.md past them.
AGENTS.md text eol=lf

# BEGIN praetor managed attributes (praetorctl adopt)
# praetorctl audit hashes these files; keep their checkout bytes the same on every platform.
.devcontainer/Dockerfile.praetor text eol=lf
tools/figures/** text eol=lf
docs/figures/*.ts text eol=lf
docs/assets/figures/* text eol=lf
tools/figures/third_party/interfig/upstream/** -text
# END praetor managed attributes
