{
  "name": "golusoris/golusoris",
  "build": {
    "dockerfile": "Dockerfile.praetor",
    "context": "."
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": false,
      "upgradePackages": true
    },
    "ghcr.io/devcontainers/features/go:1": {}
  },
  "customizations": {
    "praetor": {
      "bootstrap": {
        "version": 1,
        "state": "source-bundle",
        "builderImage": "docker.io/library/golang:1.27-alpine@sha256:4cb7ac979db5fcc41cae44b2227ba5ab8a51e8807f40d9ba4dee20a0ad960b5b",
        "baseImage": "mcr.microsoft.com/devcontainers/base@sha256:91eff046d5c12318fc98e59258982b87ba896c467427ed8b5dab5a02107a5db7",
        "sourceSHA256": "sha256:d7797c4ccd4ca7362ba07eac4390b359b299fbd38dd9fdd872f504102b48582e",
        "archiveSHA256": "sha256:58ddb577dfbd5c5f2dd107f5cc18887fc6b592edea4a34ca080efddfd57db27c",
        "archiveParts": 7,
        "dockerfileSHA256": "sha256:6ce07963e1c92bc86012ee8b096f5e0a1678522e5f221f9c691002a0f6c40849"
      }
    },
    "vscode": {
      "extensions": [
        "GitHub.vscode-pull-request-github",
        "aquasecurity.trivy-vulnerability-scanner",
        "davidanson.vscode-markdownlint",
        "eamodio.gitlens",
        "github.copilot",
        "golang.go",
        "ms-azuretools.vscode-docker",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "go.lintOnSave": "package",
        "go.lintTool": "golangci-lint",
        "go.toolsManagement.autoUpdate": false,
        "go.useLanguageServer": true,
        "security.workspace.trust.enabled": true
      }
    }
  },
  "remoteUser": "vscode",
  "postCreateCommand": "export PATH=\"/usr/local/bin:$PATH\"; /usr/local/bin/praetorctl compile-context && /usr/bin/make verify-all"
}
