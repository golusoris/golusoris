# Variant for media-heavy apps needing system libs (libav, libvips, opencv, tesseract).
# Uses Chainguard wolfi-base which lets us apk add system packages.

# ---- Build stage ----
FROM cgr.dev/chainguard/wolfi-base:latest@sha256:1f6b749929164c3d9e7cad0289254f39b2ba51e1dddaeb0fa57532ea03f2db31 AS builder

RUN apk add --no-cache \
    go-1.27=1.27.4-r0 \
    build-base=1-r10 \
    pkgconf=3.0.10-r3 \
    ffmpeg-9.0-dev=9.0.2-r9 \
    libvips-dev=8.18.7-r3 \
    glycin-2=2.2.6-r0 \
    opencv-dev=4.13.0-r4 \
    tesseract-dev=5.5.2-r8

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .

ARG VERSION=dev
ARG COMMIT=unknown
ARG DATE=unknown
ARG TARGETOS=linux
ARG TARGETARCH

RUN CGO_ENABLED=1 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build \
    -trimpath \
    -ldflags="-s -w \
        -X main.version=${VERSION} \
        -X main.commit=${COMMIT} \
        -X main.date=${DATE}" \
    -o /out/app ./cmd/app

# ---- Runtime stage ----
FROM cgr.dev/chainguard/wolfi-base:latest@sha256:1f6b749929164c3d9e7cad0289254f39b2ba51e1dddaeb0fa57532ea03f2db31

RUN apk add --no-cache \
    ffmpeg-9.0=9.0.2-r9 \
    libvips=8.18.7-r3 \
    glycin-2=2.2.6-r0 \
    opencv=4.13.0-r4 \
    tesseract=5.5.2-r8 \
    tesseract-eng=5.5.2-r8

WORKDIR /
COPY --from=builder /out/app /app

USER nonroot

EXPOSE 8080

# Probe the framework's /livez endpoint from the orchestrator. The framework
# does not require applications to implement a healthcheck CLI subcommand.

ENTRYPOINT ["/app"]
