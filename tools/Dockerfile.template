# Multi-stage build for golusoris-based apps (no media deps).
# Apps copy + adjust the `cmd` path. For media-heavy apps see Dockerfile.media.template.

# ---- Build stage ----
FROM cgr.dev/chainguard/go:latest@sha256:e69d8becae614abc5037093bead1f40bd031dd3483657f0cbeaa7e2c9e044a66 AS builder

WORKDIR /src

# Cache go module deps
COPY go.mod go.sum ./
RUN go mod download

COPY . .

ARG VERSION=dev
ARG COMMIT=unknown
ARG DATE=unknown

RUN CGO_ENABLED=0 go build \
    -trimpath \
    -ldflags="-s -w \
        -X main.version=${VERSION} \
        -X main.commit=${COMMIT} \
        -X main.date=${DATE}" \
    -o /out/app ./cmd/app

# ---- Runtime stage ----
FROM cgr.dev/chainguard/static:latest@sha256:bf639cba19ba56329e6907ac26a7afcdde57a80b6aa66d5100da6883196e6b82

WORKDIR /
COPY --from=builder /out/app /app

USER nonroot:nonroot

EXPOSE 8080

# Chainguard/static has no HTTP client. Probe /livez from the orchestrator
# instead of adding mutable packages or a permanently broken in-image probe.

ENTRYPOINT ["/app"]
