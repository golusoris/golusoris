# Multi-stage build for golusoris-based apps (no media deps).
# Apps copy + adjust the `cmd` path. For media-heavy apps see Dockerfile.media.template.

# ---- Build stage ----
FROM cgr.dev/chainguard/go:latest@sha256:0e87094aeae3d022d3926c756d7358dcc67bb1028a890989eb4224e2349c8481 AS builder

WORKDIR /src

# Cache go module deps
COPY go.mod go.sum ./
RUN go mod download

COPY . .

ARG VERSION=dev
ARG COMMIT=unknown
ARG DATE=unknown
ARG TARGETOS=linux
ARG TARGETARCH

RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build \
    -trimpath \
    -ldflags="-s -w \
        -X main.version=${VERSION} \
        -X main.commit=${COMMIT} \
        -X main.date=${DATE}" \
    -o /out/app ./cmd/app

# ---- Runtime stage ----
FROM cgr.dev/chainguard/static:latest@sha256:8658e9eaeb2294fa0e49b0667f7d66b4e21fa7690b8d2a4c30cd1d013ceb9eb7

WORKDIR /
COPY --from=builder /out/app /app

USER nonroot:nonroot

EXPOSE 8080

# Chainguard/static has no HTTP client. Probe /livez from the orchestrator
# instead of adding mutable packages or a permanently broken in-image probe.

ENTRYPOINT ["/app"]
