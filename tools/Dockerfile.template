# Multi-stage build for golusoris-based apps (no media deps).
# Apps copy + adjust the `cmd` path. For media-heavy apps see Dockerfile.media.template.

# ---- Build stage ----
FROM cgr.dev/chainguard/go:latest@sha256:00baf52adcedad9389583ee234640002e5d62e101570f1bf54edf78c63ea3bcc AS builder

WORKDIR /src

# Cache go module deps
COPY go.mod go.sum ./
RUN go mod download

COPY . .

ARG VERSION=dev
ARG COMMIT=unknown
ARG DATE=unknown
ARG TARGETOS=linux
ARG TARGETARCH

RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build \
    -trimpath \
    -ldflags="-s -w \
        -X main.version=${VERSION} \
        -X main.commit=${COMMIT} \
        -X main.date=${DATE}" \
    -o /out/app ./cmd/app

# ---- Runtime stage ----
FROM cgr.dev/chainguard/static:latest@sha256:fc42af33e643f20d08baf03cddcc1c02ba57052dfb02edb0d79f3fc47bcea8d9

WORKDIR /
COPY --from=builder /out/app /app

USER nonroot:nonroot

EXPOSE 8080

# Chainguard/static has no HTTP client. Probe /livez from the orchestrator
# instead of adding mutable packages or a permanently broken in-image probe.

ENTRYPOINT ["/app"]
