# Multi-stage build for golusoris-based apps (no media deps).
# Apps copy + adjust the `cmd` path. For media-heavy apps see Dockerfile.media.template.

# ---- Build stage ----
FROM cgr.dev/chainguard/go:latest@sha256:73e9c0d70c92c160e5e4c649531f6ef7fb0c8a9c3308cfe3534afb669ac52567 AS builder

WORKDIR /src

# Cache go module deps
COPY go.mod go.sum ./
RUN go mod download

COPY . .

ARG VERSION=dev
ARG COMMIT=unknown
ARG DATE=unknown

RUN CGO_ENABLED=0 go build \
    -trimpath \
    -ldflags="-s -w \
        -X main.version=${VERSION} \
        -X main.commit=${COMMIT} \
        -X main.date=${DATE}" \
    -o /out/app ./cmd/app

# ---- Runtime stage ----
FROM cgr.dev/chainguard/static:latest@sha256:fe55470f22d3259488d9d3739168d8f04da67755f0b69382bc26eda4a7d3d327

WORKDIR /
COPY --from=builder /out/app /app

USER nonroot:nonroot

EXPOSE 8080

# Chainguard/static has no HTTP client. Probe /livez from the orchestrator
# instead of adding mutable packages or a permanently broken in-image probe.

ENTRYPOINT ["/app"]
